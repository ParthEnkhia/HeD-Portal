{
  "name": "hed-leave-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 0.0.0.0 --config frontend/vite.config.js",
    "server": "nodemon backend/index.js",
    "start": "node backend/index.js",
